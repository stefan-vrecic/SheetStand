<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme._3PagePdf">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme._3PagePdf">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TwoPageActivity"
            android:exported="false"
            android:label="2-Page Mode"
            android:theme="@style/Theme._3PagePdf"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ThreePageActivity"
            android:exported="false"
            android:label="3-Page Mode"
            android:theme="@style/Theme._3PagePdf"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".FourPageActivity" android:exported="false" />
        <activity
            android:name=".AutoScrollActivity"
            android:exported="false"
            android:label="Auto-Scroll Mode"
            android:theme="@style/Theme._3PagePdf"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>